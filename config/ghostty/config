#----------------------------------
# ghostty.
#----------------------------------
# theme = dark:oled-rose-pine,light:catppuccin-latte.conf
theme = dark:atom-one-dark-oled.conf, light:catppuccin-latte.conf
# theme = dark:TokyoNight, light:TokyoNight Day

font-family = MesloLGS NF
font-size = 20
# background-opacity = 1
background-opacity = 0.95
# background-blur-radius = 20
background-blur-radius = 25
unfocused-split-opacity = 0.75
confirm-close-surface = false
window-width = 100
window-height = 30
window-padding-x = 20
window-padding-y = 10, 20

#----------------------------------
# macOS specific features
#----------------------------------
macos-titlebar-style = tabs
# macos-titlebar-style = hidden
macos-option-as-alt = true 
window-vsync = true
window-colorspace = display-p3
title = " "

#----------------------------------
# keybindings
#----------------------------------
keybind = cmd+shift+equal=increase_font_size:1

